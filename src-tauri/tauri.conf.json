{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PHPBlitz",
  "version": "0.1.5",
  "identifier": "dev.phpblitz.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PHPBlitz",
        "width": 820,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PHPBlitz",
    "copyright": "Copyright © 2026 The PHPBlitz Authors. Licensed under the Apache License 2.0.",
    "license": "Apache-2.0",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "homepage": "https://github.com/bilelbho/phpblitz",
    "category": "DeveloperTool",
    "shortDescription": "A fast, open source PHP IDE",
    "longDescription": "PHPBlitz is a fast, open source PHP IDE built with Rust and Tauri: code navigation, find usages and rename from its own index, Mago analysis, Git, databases, Xdebug and a terminal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
